    "test:library": "node --test tests/library.test.mjs"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
