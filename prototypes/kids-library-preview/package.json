{
  "name": "kids-library-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/prepare-sites-build.mjs",
    "build:preview": "node node_modules/vite/bin/vite.js build --outDir ../../web/kids-library-preview --emptyOutDir",
    "preview": "node node_modules/vite/bin/vite.js preview",
