{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "vercel-public",
  "framework": null,
  "redirects": [
    {
      "source": "/web/llm-db/",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/llm-db/:path*",
      "destination": "/web/library/",
      "permanent": true
    }
  ]
}
