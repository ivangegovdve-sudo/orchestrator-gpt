{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "vercel-public",
  "framework": null,
  "rewrites": [
    { "source": "/api/library/:path*", "destination": "/api/library-proxy?subpath=:path*" }
  ],
  "functions": {
    "api/council.js": {
      "maxDuration": 300
    },
    "api/library-proxy.js": {
      "maxDuration": 30
    }
  }
}
