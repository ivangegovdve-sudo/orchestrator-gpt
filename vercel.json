{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "vercel-public",
  "framework": null,
  "redirects": [
    {
      "source": "/web/ai-init",
      "destination": "/web/library/glossary/",
      "permanent": true
    },
    {
      "source": "/web/ai-init/",
      "destination": "/web/library/glossary/",
      "permanent": true
    },
    {
      "source": "/web/llm-db/",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/llm-db/:path*",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/tinylm",
      "destination": "/web/council/index.html#tinylm",
      "permanent": true
    },
    {
      "source": "/web/tinylm/",
      "destination": "/web/council/index.html#tinylm",
      "permanent": true
    }
  ]
}
