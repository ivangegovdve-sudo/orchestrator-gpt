{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "vercel-public",
  "framework": null,
  "rewrites": [
    {
      "source": "/firsthand",
      "destination": "https://cognitive-autonomy-app.vercel.app/firsthand"
    },
    {
      "source": "/firsthand/:path*",
      "destination": "https://cognitive-autonomy-app.vercel.app/firsthand/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/web/ai-init",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/ai-init/",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/llm-db/",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/llm-db/:path*",
      "destination": "/web/library/",
      "permanent": true
    },
    {
      "source": "/web/tinylm",
      "destination": "/web/council/index.html#tinylm",
      "permanent": true
    },
    {
      "source": "/web/tinylm/",
      "destination": "/web/council/index.html#tinylm",
      "permanent": true
    }
  ]
}
